# API
DATABASE_URL=postgresql://mira:mira@localhost:5432/mira
REDIS_URL=redis://localhost:6379
AUDIO_DIR=./data/audio
TTS_DIR=./data/tts
API_CORS_ORIGINS=http://localhost:3000
RERANK_ENABLED=false

# Keys
ASSEMBLYAI_API_KEY=
VOYAGE_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# Models
# Use voyage-4 on /embeddings. voyage-context-4 is not accepted there.
VOYAGE_EMBED_MODEL=voyage-4
VOYAGE_EMBED_DIM=1024
VOYAGE_RERANK_MODEL=rerank-2.5
ANTHROPIC_ROUTE_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_GROUND_MODEL=claude-sonnet-4-5-20250929

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production: NEXT_PUBLIC_API_URL=/backend
# Production: API_INTERNAL_URL=http://127.0.0.1:8000
# Neon: use the direct DATABASE_URL (not the pooler), sslmode=require